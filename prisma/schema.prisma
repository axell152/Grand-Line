generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Une sauvegarde par "saveId" (simple, pas de compte utilisateur pour un usage perso)
model SaveGame {
  id          String   @id @default(cuid())
  saveId      String   @unique // identifiant local stocké dans le navigateur
  islandId    String // île actuelle
  x           Int
  y           Int
  crew        Json // liste des personnages recrutés + leurs stats
  berrys      Int      @default(0) // monnaie du jeu
  flags       Json // progression : combats gagnés, îles débloquées, etc.
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}
